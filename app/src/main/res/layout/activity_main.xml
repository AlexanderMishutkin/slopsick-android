<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/status_off_hint"
            android:textSize="14sp" />

        <Button
            android:id="@+id/openSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/open_settings" />

        <!-- Apps -->
        <TextView
            style="@style/SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_apps" />

        <Switch
            android:id="@+id/optInstagram"
            style="@style/Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_instagram" />

        <Switch
            android:id="@+id/optLinkedIn"
            style="@style/Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_linkedin" />

        <Switch
            android:id="@+id/optYouTube"
            style="@style/Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_youtube" />

        <TextView
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apps_hint" />

        <!-- Lock -->
        <TextView
            style="@style/SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_lock" />

        <TextView
            android:id="@+id/lockStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <NumberPicker
                android:id="@+id/lockMinutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/lock_minutes"
                android:textSize="15sp" />

            <Button
                android:id="@+id/lockButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/lock_button" />
        </LinearLayout>

        <TextView
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_hint" />

        <TextView
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_honest" />

        <!-- Detail -->
        <TextView
            style="@style/SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_what" />

        <Switch
            android:id="@+id/optSuggested"
            style="@style/Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_suggested" />

        <Switch
            android:id="@+id/optPromoted"
            style="@style/Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_promoted" />

        <Switch
            android:id="@+id/optReels"
            style="@style/Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_reels" />

        <Switch
            android:id="@+id/optExplore"
            style="@style/Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_explore" />

        <Switch
            android:id="@+id/optShorts"
            style="@style/Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_shorts" />

        <Switch
            android:id="@+id/optModules"
            style="@style/Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_modules" />

        <Switch
            android:id="@+id/optActivity"
            style="@style/Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_activity" />

        <TextView
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_activity_sub" />

        <Switch
            android:id="@+id/optStories"
            style="@style/Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opt_stories" />

        <!-- Privacy -->
        <TextView
            style="@style/SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_privacy" />

        <TextView
            style="@style/Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/privacy_body" />
    </LinearLayout>
</ScrollView>
