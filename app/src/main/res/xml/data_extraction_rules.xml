<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Nothing to back up: the only state is a handful of switches. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
