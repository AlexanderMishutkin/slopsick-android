<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      There is deliberately no <uses-permission> element in this file.

      In particular there is no INTERNET permission: this app cannot open a socket, so
      it cannot send anything it reads from your feed anywhere, whatever its code says.
      That is enforced by the system, not by good intentions. Adding a permission here
      is the single change a reviewer should refuse.

      The overlay is drawn as TYPE_ACCESSIBILITY_OVERLAY, which an accessibility service
      may create without SYSTEM_ALERT_WINDOW ("draw over other apps").
    -->

    <!--
      Not a permission: this declares which packages this app can *see* the existence of,
      which Android 11 and later otherwise hide. It is the four apps the accessibility
      service already receives events from, named one by one rather than with
      QUERY_ALL_PACKAGES, and it is here for one reason — a bug report is close to
      useless without the version of the app it came from. Every problem reported so far
      has turned out to be a difference between two builds of the same app.
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.android.chrome" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusTube">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".platform.SlopsickAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
